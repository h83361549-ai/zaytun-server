{
  "name": "zaytun",
  "version": "1.1.0",
  "description": "برنامه چت اختصاصی گروه رفیقا",
  "author": "Zaytun Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "publish:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.4",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zaytun.chat",
    "productName": "Zaytun",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "h83361549-ai",
      "repo": "zaytun-releases"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ]
  }
}
